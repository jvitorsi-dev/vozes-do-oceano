; VOZES DO OCEANO — jogo de exploração psicológica em primeira pessoa
; Inspirado nos temas de "Solaris", de Stanisław Lem.
;
; Projeto Godot 4.4. Os mapas de entrada (input map) são criados em código
; por scripts/core/boot.gd para manter este arquivo enxuto.

config_version=5

[application]

config/name="Vozes do Oceano"
config/description="Uma estação abandonada em órbita de um planeta-oceano. Você não está sozinho."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.015, 0.02, 0.028, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Boot="*res://scripts/core/boot.gd"
Content="*res://scripts/core/content.gd"
GameState="*res://scripts/core/game_state.gd"
AudioMan="*res://scripts/core/audio_man.gd"
Ocean="*res://scripts/core/ocean.gd"
Director="*res://scripts/core/director.gd"
UI="*res://scripts/ui/ui.gd"

[rendering]

renderer/rendering_method.web="gl_compatibility"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1400
window/size/window_height_override=788
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0

[rendering]

renderer/rendering_method="forward_plus"
# build "compat" (preset Windows Compat, custom_features=compat): o mesmo
# renderizador que o CI confere a cada push — usado enquanto o crash do
# Forward+/Vulkan na primeira tela não é diagnosticado
renderer/rendering_method.compat="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
limits/opengl/max_lights_per_object=32
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.01, 0.013, 0.02, 1)
camera/depth_of_field/depth_of_field_bokeh_shape=1
limits/spatial_indexer/threaded_cull_minimum_instances=500

[input_devices]

pointing/emulate_touch_from_mouse=false
